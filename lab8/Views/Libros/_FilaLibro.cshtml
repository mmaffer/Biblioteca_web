@model Libro

<tr>
    <td class="cell-title">@Model.Titulo</td>
    <td>@Model.AutorNombre</td>
    <td class="cell-muted">@Model.ISBN</td>
    <td class="text-center">
        <span class="pill @(Model.Ejemplares == 0 ? "pill-bad" : Model.Ejemplares <= 1 ? "pill-warn" : "pill-ok")">@Model.Ejemplares</span>
    </td>
    <td class="text-end text-nowrap">
        <a class="btn btn-icon btn-outline-secondary" asp-action="Details" asp-route-id="@Model.LibroId">Detalle</a>
        <a class="btn btn-icon btn-outline-primary" asp-action="Edit" asp-route-id="@Model.LibroId">Editar</a>
        <a class="btn btn-icon btn-outline-danger" asp-action="Delete" asp-route-id="@Model.LibroId">Eliminar</a>
    </td>
</tr>
